# DailyPrayer — Environment Variables Example
#
# Copy to .env and fill in. .env is gitignored — never commit it.
#
# NOTE: Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build
# time and is readable by anyone who downloads the app. Only put values here
# that are safe to publish. Secret keys belong on a server.

# ── Supabase ──────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── RevenueCat (public SDK keys — safe to ship) ───────────
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_your_ios_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your_android_key

# ── Bible API ─────────────────────────────────────────────
# Optional. Overrides the default translation id used against the
# wldeh/bible-api CDN. Must be a public-domain edition.
# EXPO_PUBLIC_BIBLE_API_VERSION=en-kjv

# ── AI assistant (optional) ───────────────────────────────
# Do NOT put an OpenCode Zen key here — it would ship in the app bundle.
# Users supply their own key via Settings, stored in SecureStore.
# To serve a hosted key, run a server proxy and point the app at it:
# EXPO_PUBLIC_AI_PROXY_URL=https://your-proxy.example.com/v1/chat/completions
